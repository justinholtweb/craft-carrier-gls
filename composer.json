{
    "name": "justinholtweb/craft-carrier-gls",
    "description": "GLS through MyGLS (HR, HU, CZ, RO, SI, SK, RS) for Carrier — labels, COD, parcel shops and lockers, tracking.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "carrier",
        "shipping",
        "gls",
        "mygls",
        "parcel-shop"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-carrier",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-carrier/docs/gls",
        "source": "https://github.com/justinholtweb/craft-carrier-gls",
        "issues": "https://github.com/justinholtweb/craft-carrier-gls/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0",
        "justinholtweb/craft-carrier": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\carriergls\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Carrier for GLS",
        "handle": "carrier-gls",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-carrier/docs/gls",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-carrier-gls/main/CHANGELOG.md",
        "class": "justinholtweb\\carriergls\\Plugin"
    }
}
